# Ambiente e servidor HTTP
NODE_ENV="production"
PORT="3000"

# SESSION_SECRET: Chave fixa (mínimo 32 caracteres) para assinar tokens de sessão.
# Obrigatório configurar na Vercel para manter logins válidos entre invocações serverless.
# Gere com: openssl rand -hex 32
SESSION_SECRET=""

# Banco de dados PostgreSQL
# Opção A (Recomendada na Vercel / Neon / Supabase): Connection String única
DATABASE_URL=""

# Opção B (Cloud SQL / PostgreSQL por parâmetros separados)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_SSL="false"
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
