# Ambiente e servidor HTTP
NODE_ENV="production"
PORT="3000"

# APP_URL: URL pública onde a aplicação está hospedada (ex: https://suapelada.com.br).
# Usada nos links de convite e recuperação de senha enviados por e-mail.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Chave fixa (mínimo 32 caracteres) para assinar tokens de sessão (login com e-mail/senha).
# Gere com: openssl rand -hex 32
SESSION_SECRET=""

# Banco de dados PostgreSQL (Cloud SQL / PostgreSQL gerenciado)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Envio automático de e-mails transacionais via Resend (convites, recuperação de senha, cobranças PIX e resumos)
RESEND_API_KEY=""
EMAIL_FROM=""

# GEMINI_API_KEY: Opcional (gerenciado automaticamente no AI Studio se utilizado).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
